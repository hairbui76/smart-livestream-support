{
  "name": "smart-livestream-support",
  "version": "0.5.0",
  "description": "Floating AI toolbox for livestreams and video calls — live transcription, EN/VI translation, and meeting summaries. Invisible to screen sharing.",
  "main": "out/main/index.js",
  "author": "apexkorea.ai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hairbui76/smart-livestream-support.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:win:zip": "electron-vite build && electron-builder --win zip -c.win.signAndEditExecutable=false",
    "whisper": "bash scripts/download-whisper.sh"
  },
  "dependencies": {
    "openai": "^4.77.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.11"
  }
}
